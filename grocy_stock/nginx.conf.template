worker_processes auto;
pid /var/run/nginx.pid;
error_log /proc/1/fd/2 warn;

events {
    worker_connections 1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;
    access_log    /proc/1/fd/1 combined;
    sendfile      on;
    tcp_nopush    on;

    server {
        listen 8099;
        root  /var/www/html;
        index index.html;

        # ── Grocy API proxy ────────────────────────────────────────────────
        # Strips /api/grocy/ prefix and forwards to the actual Grocy server.
        # The API key is injected on the server side so it is never exposed
        # to the browser.
        location /api/grocy/ {
            proxy_pass         ${GROCY_BASE_URL}/api/;
            proxy_set_header   GROCY-API-KEY "${GROCY_API_KEY}";
            proxy_set_header   Host              $http_host;
            proxy_set_header   X-Real-IP         $remote_addr;
            proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_http_version 1.1;
            proxy_buffering    off;
        }

        # ── Barcode Buddy API proxy ────────────────────────────────────────
        # Strips /api/bbuddy/ prefix and forwards to the Barcode Buddy server.
        # The API key is injected on the server side so it is never exposed
        # to the browser.
        location /api/bbuddy/ {
            proxy_pass         ${BBUDDY_URL}/api/;
            proxy_set_header   BBUDDY-API-KEY "${BBUDDY_API_KEY}";
            proxy_set_header   Host              $http_host;
            proxy_set_header   X-Real-IP         $remote_addr;
            proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_http_version 1.1;
            proxy_buffering    off;
        }

        # ── Static assets (long-lived cache) ──────────────────────────────
        location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
            expires    1y;
            add_header Cache-Control "public, immutable";
            try_files  $uri =404;
        }

        # ── React SPA ─────────────────────────────────────────────────────
        # Inject the HA ingress path into the HTML so the React app can
        # build correct absolute URLs when needed.
        location / {
            gzip off;
            sub_filter
                '<meta name="ingress-path" content="">'
                '<meta name="ingress-path" content="$http_x_ingress_path">';
            sub_filter_once on;
            add_header Cache-Control "no-cache" always;
            try_files $uri $uri/ /index.html;
        }
    }
}
