worker_processes auto;
pid /var/run/nginx.pid;
error_log /proc/1/fd/2 warn;

events {
    worker_connections 1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;
    sendfile      on;
    tcp_nopush    on;

    # ── Conditional access logging ────────────────────────────────────
    # When debug mode is off, suppress routine successful polling
    # requests (stock, locations, product_groups) and static assets
    # to keep the log clean.  Errors and meaningful actions (scans,
    # consumes, discovers) are always logged.

    # 1 = error/redirect response
    map $status $is_error {
        ~^[^23]  1;
        default  0;
    }

    # 1 = routine polling endpoint or static asset
    map $request_uri $is_routine {
        default                                                   0;
        ~^/api/storage/(stock|product-groups|locations)            1;
        ~\.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)(\?|$)     1;
    }

    # Combine: suppress routine+success when not in debug mode.
    # NGINX_LOG_ROUTINE is "1" (debug on = log everything) or
    # "0" (debug off = suppress routine successes).
    map "$is_routine:$is_error" $loggable {
        default  1;
        "1:0"    ${NGINX_LOG_ROUTINE};
    }

    access_log /proc/1/fd/1 combined if=$loggable;

    server {
        listen 8099;
        root  /var/www/html;
        index index.html;

        # ── Storage API proxy ──────────────────────────────────────────────
        # Strips /api/storage/ prefix and forwards to the HA-Storage addon.
        # No API key needed — Storage handles auth internally.
        location /api/storage/ {
            proxy_pass         ${STORAGE_URL}/api/;
            proxy_set_header   Host              $http_host;
            proxy_set_header   X-Real-IP         $remote_addr;
            proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_http_version 1.1;
            proxy_buffering    off;
        }

        # ── Grocy Scraper proxy ───────────────────────────────────────────
        # Forwards to the grocy_scraper addon's ingress server (auto-detected
        # via Supervisor API or manually configured).  The longer timeout
        # accommodates K-Ruoka product lookups which can be slow.
        location /api/scraper/ {
            proxy_pass         ${SCRAPER_URL}/api/;
            proxy_set_header   Host              $http_host;
            proxy_set_header   X-Real-IP         $remote_addr;
            proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_http_version 1.1;
            proxy_buffering    off;
            proxy_read_timeout 120s;
            proxy_send_timeout 120s;
        }

        # ── Static assets (long-lived cache) ──────────────────────────────
        location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
            expires    1y;
            add_header Cache-Control "public, immutable";
            try_files  $uri =404;
        }

        # ── React SPA ─────────────────────────────────────────────────────
        # Inject the HA ingress path into the HTML so the React app can
        # build correct absolute URLs when needed.
        # The Permissions-Policy header signals to HA's ingress that this
        # page needs camera and microphone access for barcode scanning.
        location / {
            gzip off;
            sub_filter
                '<meta name="ingress-path" content="">'
                '<meta name="ingress-path" content="$http_x_ingress_path">';
            sub_filter_once on;
            add_header Cache-Control "no-cache" always;
            add_header Permissions-Policy "camera=*, microphone=*" always;
            try_files $uri $uri/ /index.html;
        }
    }
}
