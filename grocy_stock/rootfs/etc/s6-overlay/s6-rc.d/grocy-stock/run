#!/command/with-contenv bashio

bashio::log.info "Starting Grocy Stock add-on..."

# ── Debug mode ────────────────────────────────────────────────────────────
# When enabled, nginx logs every request.  When disabled (default), routine
# polling requests (stock, product-groups, locations) are suppressed.
if bashio::config.true 'debug'; then
    NGINX_LOG_ROUTINE="1"
    bashio::log.info "Debug mode: ON — all requests will be logged"
else
    NGINX_LOG_ROUTINE="0"
    bashio::log.info "Debug mode: OFF — routine polling requests suppressed from log"
fi
export NGINX_LOG_ROUTINE

# Read Storage URL from Home Assistant config
STORAGE_URL=$(bashio::config 'storage_url')
export STORAGE_URL

# ── Grocy Scraper auto-detect ─────────────────────────────────────────────
# Try to locate the grocy_scraper addon on this HA instance so the frontend
# can trigger single-barcode discover without manual URL configuration.
#
# Strategy 1: Derive the scraper hostname from our own HOSTNAME.  In HA
#   Supervisor, addon containers get hostnames like "<hash>_grocy_stock".
#   If both addons come from the same repo, the scraper is
#   "<hash>_grocy_scraper" on the Docker network.
# Strategy 2: Try the Supervisor API (requires hassio_api: true).
# Strategy 3: Fall back to the manual scraper_url config option.
SCRAPER_URL=""

if bashio::config.has_value 'scraper_url'; then
    SCRAPER_URL=$(bashio::config 'scraper_url')
    bashio::log.info "Scraper URL (from config): ${SCRAPER_URL}"
else
    bashio::log.info "Attempting auto-detect of Grocy Scraper addon..."

    # Strategy 1: Derive from our own hostname / HOSTNAME env.
    # HA Supervisor sets the container hostname to the full addon slug,
    # but also exposes it as the HOSTNAME env var.  Try both sources and
    # normalise to underscores (Docker DNS uses underscores for HA slugs,
    # but the `hostname` command may return hyphens on some images).
    MY_HOSTNAME="${HOSTNAME:-}"
    if [ -z "${MY_HOSTNAME}" ]; then
        MY_HOSTNAME=$(hostname 2>/dev/null) || true
    fi
    # Also try /etc/hostname as last resort
    if [ -z "${MY_HOSTNAME}" ] && [ -f /etc/hostname ]; then
        MY_HOSTNAME=$(cat /etc/hostname 2>/dev/null) || true
    fi
    bashio::log.info "Container hostname: '${MY_HOSTNAME}'"

    if [ -n "${MY_HOSTNAME}" ]; then
        # Normalise to hyphens for matching (HA uses hyphens in hostnames)
        MY_HOSTNAME_NORM=$(echo "${MY_HOSTNAME}" | tr '_' '-')

        # Strip our own addon slug suffix to get the repo hash prefix.
        REPO_PREFIX="${MY_HOSTNAME_NORM%%-grocy-stock}"
        if [ "${REPO_PREFIX}" != "${MY_HOSTNAME_NORM}" ] && [ -n "${REPO_PREFIX}" ]; then
            # Probe both hyphen and underscore variants — HA Supervisor
            # has used both conventions across versions.
            for CANDIDATE in "${REPO_PREFIX}-grocy-scraper" "${REPO_PREFIX}_grocy_scraper"; do
                bashio::log.info "Probing scraper at ${CANDIDATE}:8099 ..."
                if curl -sf --max-time 3 "http://${CANDIDATE}:8099/api/config" >/dev/null 2>&1; then
                    SCRAPER_URL="http://${CANDIDATE}:8099"
                    bashio::log.info "Scraper URL (auto-detected via hostname): ${SCRAPER_URL}"
                    break
                fi
            done
        else
            bashio::log.info "Hostname '${MY_HOSTNAME}' did not match expected pattern '<hash>-grocy-stock'"
        fi
    fi

    # Strategy 2: Supervisor API (needs hassio_api: true).
    if [ -z "${SCRAPER_URL}" ] && [ -n "${SUPERVISOR_TOKEN}" ]; then
        SCRAPER_SLUG=""
        SCRAPER_SLUG=$(curl -sf --max-time 5 \
            -H "Authorization: Bearer ${SUPERVISOR_TOKEN}" \
            http://supervisor/addons \
            | jq -r '
                [.data.addons[]?
                 | select(.slug | test("grocy.scraper"; "i"))
                ][0].slug // empty
            ' \
        ) || true

        if [ -z "${SCRAPER_SLUG}" ]; then
            SCRAPER_SLUG=$(curl -sf --max-time 5 \
                -H "Authorization: Bearer ${SUPERVISOR_TOKEN}" \
                http://supervisor/addons \
                | jq -r '
                    [.data.addons[]?
                     | select(.name | test("grocy.scraper"; "i"))
                    ][0].slug // empty
                ' \
            ) || true
        fi

        if [ -n "${SCRAPER_SLUG}" ]; then
            SCRAPER_IP=""
            SCRAPER_IP=$(curl -sf --max-time 5 \
                -H "Authorization: Bearer ${SUPERVISOR_TOKEN}" \
                "http://supervisor/addons/${SCRAPER_SLUG}/info" \
                | jq -r '.data.ip_address // empty' \
            ) || true

            if [ -n "${SCRAPER_IP}" ]; then
                SCRAPER_URL="http://${SCRAPER_IP}:8099"
                bashio::log.info "Scraper URL (auto-detected via API): ${SCRAPER_URL}"
            else
                # Try using the slug as Docker hostname directly.
                if curl -sf --max-time 3 "http://${SCRAPER_SLUG}:8099/api/config" >/dev/null 2>&1; then
                    SCRAPER_URL="http://${SCRAPER_SLUG}:8099"
                    bashio::log.info "Scraper URL (auto-detected via slug): ${SCRAPER_URL}"
                fi
            fi
        fi
    fi

    if [ -z "${SCRAPER_URL}" ]; then
        bashio::log.info "Grocy Scraper addon not found — discover integration disabled."
    fi
fi

if [ -z "${SCRAPER_URL}" ]; then
    SCRAPER_URL="http://127.0.0.1:1"  # unreachable placeholder; frontend handles errors gracefully
fi

export SCRAPER_URL

bashio::log.info "Storage URL: ${STORAGE_URL}"
bashio::log.info "Generating nginx configuration..."

# Substitute our variables; leave all nginx $vars untouched
envsubst '${STORAGE_URL} ${SCRAPER_URL} ${NGINX_LOG_ROUTINE}' \
  < /etc/nginx/nginx.conf.template \
  > /etc/nginx/nginx.conf

bashio::log.info "Starting nginx on port 8099..."
exec nginx -g "daemon off;"
